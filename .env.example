# Financial Statement environment template — copy to .env and adjust. NEVER commit .env.
# The app runs fully with the defaults below (SQLite + mock AI, zero keys).

# ---- backend ----
# SQLite (dev/test):            sqlite:///./financial-statement.db
# Postgres (compose/prod):      postgresql+psycopg://user:pass@host:5432/financial_statement
DATABASE_URL=sqlite:///./financial-statement.db

# JWT signing secret — generate a real one for any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# AI provider: "mock" = deterministic offline responses (tests/CI/demos),
#              "gemini" = live Google Gemini (requires GEMINI_API_KEY).
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Agent tuning: bound on the self-criticism revise loop (notes drafting)
AI_MAX_CRITIQUE_LOOPS=2

# Validation tuning
ANOMALY_PCT_THRESHOLD=50
FILING_DEADLINE_MONTHS=4

# Comma-separated origins, or * (dev). Set explicitly in production.
CORS_ORIGINS=*

# ---- frontend (build time) ----
# Empty = same-origin (vite dev proxy / nginx in compose). Set for split hosting.
VITE_API_URL=

# ---- observability (docs/observability.md) -------------------------------------
# OTEL_ENABLED=true exports traces + JSON logs to the OTel collector (compose --profile obs).
# Unset/false => zero exporters; Prometheus metrics on :8000/metrics are ALWAYS on.
OTEL_ENABLED=false
OTEL_ENVIRONMENT=dev
OTEL_SERVICE_NAME=financial-statement-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Grafana local demo login (compose obs profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
